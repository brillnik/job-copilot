CORS_ORIGINS=["http://localhost:3000"]
# docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_copilot

# Document storage: "local" (disk) or "s3" (MinIO locally; docker compose up -d minio minio-init)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-copilot
